APP_NAME="Cross Crossing Medical Centre"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.ccmctt.com
APP_TIMEZONE=America/Port_of_Spain
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# One-time web installer (only needed if you have no SSH). Remove after setup.
SETUP_TOKEN=

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_ccmc
DB_USERNAME=u000000000_ccmc
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Hostinger mailbox (hPanel → Emails).
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=web@ccmctt.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=web@ccmctt.com
MAIL_FROM_NAME="${APP_NAME}"

# Company details shown on the site (confirm with the client).
# true on the temporary preview domain: banner + noindex. Remove at launch.
CCMC_PREVIEW=false
# Main lines, comma separated; the first is the one on every Call button.
CCMC_PHONES="868-652-4411,868-652-4412"
CCMC_FAX="868-652-4413"
CCMC_EMAIL=mail@ccmctt.com
# Who gets "new request" emails, comma separated (front desk / records inboxes).
CCMC_NOTIFY_EMAIL=
# Who gets "new job application" emails (HR). Falls back to CCMC_NOTIFY_EMAIL.
CCMC_NOTIFY_HR_EMAIL=
# true only once the centre confirms it takes visiting / holiday dialysis patients.
CCMC_DIALYSIS_VISITORS=false

# First staff account, created by `php artisan db:seed` (or setup.php). Remove the password after first sign-in.
#ADMIN_NAME="Administrator"
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
